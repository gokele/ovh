# ==============================================
# OVH 控制台 (Go server) - 配置文件
# 复制此文件为 .env 并修改配置值
# ==============================================

# ── 登录账号 ──
# 控制台用「用户名 + 密码」登录。首次创建账号任选一种:
#
# 方式一:写好管理员账号,首次启动自动创建(密码至少 8 位)。
#   之后在网页「设置 → 登录账号」改密码,这里不会再覆盖它。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
#
# 方式二:不写上面两行,首次打开网页时创建,需要输入初始化密钥 = API_SECRET_KEY。
#   留空则自动生成,启动日志和数据目录 .api-secret 里有。
#   旧版本升级:保留原来的 API_SECRET_KEY 即可,它就是初始化密钥;
#   用过旧版的浏览器会自动带上,只需填用户名和密码。账号建好后它不再用于登录。
# 生成方法: openssl rand -hex 32
API_SECRET_KEY=
#
# 忘记密码:写上 ADMIN_USERNAME / ADMIN_PASSWORD 并设 ADMIN_PASSWORD_RESET=1,重启一次
#   (所有设备会被退出),登录后删掉这两行。
# ADMIN_PASSWORD_RESET=1

# 后端端口
PORT=19998

# 调试模式（开发: true, 生产: false）
DEBUG=false

# 是否启用登录验证(false = 不用登录,任何人都能操作,仅限本地调试)
ENABLE_AUTH=true

# 监听地址。默认空 = 所有网卡（localhost / 127.0.0.1 / 局域网 IP 都能访问）
# 想锁回环写 127.0.0.1；公网部署写 0.0.0.0
LISTEN_HOST=

# Gin 模式: debug / release
GIN_MODE=release

# 数据库加密密钥（首次启动自动生成并写回这个文件，通常不用自己填）
# 加密的是数据库里的 OVH API 凭据和 Telegram Token —— 拿到 sniper.db
# 就等于拿到你 OVH 账户的完全控制权（能下单、能重装、能删机器）。
#
# 备份配置文件时别漏了这一行：丢了它，已保存的账户就再也解不开，只能重新录入。
# 想让密钥完全不落盘，就用环境变量传进来（容器里推荐这么做），这个文件里就别写。
# OVH_DB_KEY=

# 配置文件自身的位置。默认是工作目录下的 .env。
# systemd / docker 里工作目录未必是程序所在目录，那种情况下写绝对路径，
# 否则密钥可能"这次写进去、下次找不到"。
# OVH_ENV_FILE=/etc/ovh-console/.env
